# Copy this file to .env and replace every password.
# .env is ignored by git. Never commit real values.
#
# Passwords may only contain letters, digits, "-" and "_".

MYSQL_ROOT_PASSWORD=replace-with-a-root-password
APP_DB_PASSWORD=replace-with-an-app-password
DIAG_DB_PASSWORD=replace-with-a-diag-password
EXPORTER_DB_PASSWORD=replace-with-an-exporter-password
GATE_DB_PASSWORD=replace-with-a-gate-password

# Host ports. Change only if these are already in use on your machine.
MYSQL_HOST_PORT=13306
PROMETHEUS_HOST_PORT=19090

# Synthetic workload.
WORKLOAD_OPERATIONS_PER_SECOND=20
WORKLOAD_WORKER_COUNT=4
WORKLOAD_RANDOM_SEED=42
